# =============================================================================
# La Positiva - plantilla de configuracion
#
# Copiá este archivo a .env y completá los valores.
#   cp .env.example .env
#
# .env NUNCA se sube: está en .gitignore y en .vercelignore.
# Para generar config.js después de editarlo:
#   node scripts/build-config.js
# =============================================================================


# -----------------------------------------------------------------------------
# PÚBLICAS - llevan el prefijo LP_PUBLIC_
#
# Estas viajan al navegador, sí o sí. No hay forma de evitarlo en un sitio
# estático: el navegador necesita estos datos para hablar con Supabase.
# No es un descuido. Lo que protege los datos es RLS, no esconder la clave.
#
# El prefijo LP_PUBLIC_ es una red de seguridad: el build solo copia a
# config.js las variables que lo llevan, así es imposible filtrar un
# secreto por error.
# -----------------------------------------------------------------------------

# URL del proyecto de Supabase.
LP_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anon. Identifica al proyecto; no da permisos por sí sola.
LP_PUBLIC_SUPABASE_ANON=

# De dónde salen las fotos de los platos.
LP_PUBLIC_IMG_BASE=https://la-positiva-phi.vercel.app/

# Clave VAPID pública. Tiene que ser el par de VAPID_PRIVATE_KEY (más abajo).
# Generá un par con: node scripts/generar-vapid.js
LP_PUBLIC_VAPID=

# Nombres de tablas y bucket. Solo si los cambiaste.
# LP_PUBLIC_TABLE=la_positiva_pedidos
# LP_PUBLIC_PUSH_TABLE=la_positiva_push_subs
# LP_PUBLIC_COBROS_TABLE=la_positiva_cobros
# LP_PUBLIC_BUCKET=la-positiva


# -----------------------------------------------------------------------------
# SECRETAS - nunca llegan al navegador
#
# Estas NO las usa el sitio: las usa la Edge Function de Supabase, que corre
# en el servidor. Están acá para que este archivo sea el inventario completo
# de claves del sistema y no tengas que buscarlas en otro lado.
#
# Se cargan una vez en:
#   Supabase > Configuración > Edge Functions > Secrets
#
# El build las ignora: no llevan el prefijo LP_PUBLIC_ y jamás entran a
# config.js.
# -----------------------------------------------------------------------------

# Firma las notificaciones push. Par de LP_PUBLIC_VAPID.
VAPID_PRIVATE_KEY=

# Copia de la pública, del lado del servidor.
VAPID_PUBLIC_KEY=

# Contacto del emisor de las notificaciones.
VAPID_SUBJECT=mailto:hola@lapositiva.com.ar

# SUPABASE_SERVICE_ROLE_KEY la inyecta Supabase sola en la Edge Function.
# NUNCA la escribas acá ni en ningún archivo del proyecto: saltea RLS.
